#include "lmt9151som_nrf9151_common-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "LMT SoM nRF9151";
	compatible = "lmt,som-nrf9151";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
	};

	aliases {
		watchdog0 = &wdt0;
		spi-flash0 = &ext_flash;
	};

	fstab {
		compatible = "zephyr,fstab";

		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs1_partition>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

// SIM SELect
&gpio0 {
	status = "okay";
	label = "GPIO0";
	gpio_25_default: gpio_25_default {
		gpio-hog;
		gpios = <25 (GPIO_ACTIVE_HIGH)>;
		output-low;
	};
};

&gpiote {
	status = "okay";
};

&uart0 {
	status = "okay";
	label = "UART0";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = < &gpio0 4 GPIO_ACTIVE_LOW >;
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";
	ext_flash: ext_flash@0 {
		label = "EXT_FLASH";
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		wp-gpios = < &gpio0 6 GPIO_ACTIVE_LOW >;
		hold-gpios = < &gpio0 3 GPIO_ACTIVE_LOW >;
		size = <33554432>;
		t-enter-dpd = <10000>;   /* 10 µs  >= tDP  of both IS25LP032D & MX25L3233F */
		t-exit-dpd  = <30000>;   /* 30 µs  >= tRES1 of both*/
		has-dpd;
	};
};

&ext_flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		lfs1_partition: partition@0 {
			label = "littlefs_storage";
			reg = <0x00000000 0x00400000>; //bytes
		};
	};
};

&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: b0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 0x8000>;
		};
		s0_partition: partition@8000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot-0";
			reg = <0x00008000 0xc000>;
		};
		/* 0x14000-0x18000: EMPTY_0 (unallocated) */
		s1_partition: partition@18000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot-1";
			reg = <0x00018000 0xc000>;
		};
		/* 0x24000-0x28000: EMPTY_1 (unallocated) */
		slot0_partition: partition@28000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00028000 0x68000>;
			ranges = <0x0 0x00028000 0x68000>;
			#address-cells = <1>;
			#size-cells = <1>;

			slot0_s_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "image-0-secure";
				reg = <0x00000000 0x8000>;
			};
			slot0_ns_partition: partition@8000 {
				compatible = "zephyr,mapped-partition";
				label = "image-0-nonsecure";
				reg = <0x00008000 0x60000>;
			};
		};
		slot1_partition: partition@90000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00090000 0x68000>;
			ranges = <0x0 0x00090000 0x68000>;
			#address-cells = <1>;
			#size-cells = <1>;

			slot1_s_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "image-1-secure";
				reg = <0x00000000 0x8000>;
			};
			slot1_ns_partition: partition@8000 {
				compatible = "zephyr,mapped-partition";
				label = "image-1-nonsecure";
				reg = <0x00008000 0x60000>;
			};
		};
		storage_partition: partition@f8000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000f8000 0x6000>;
			ranges = <0x0 0x000f8000 0x6000>;
			#address-cells = <1>;
			#size-cells = <1>;
			/* PM: nvs_storage, used by lmtSDK fs_nvs (6 x 4 KiB) */
			nvs_storage: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "nvs_storage";
				reg = <0x0 0x6000>;
			};
		};
		/* 0xfe000-0x100000: EMPTY_2 (unallocated) */
	};
};


&sram0 {
	sram0_s: sram@0 {
		reg = <0x0 0x8000>;
	};
	sram0_ns: sram@8000 {
		reg = <0x8000 0x38000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x8000 0x38000>;

		sram0_ns_modem: sram0_ns@0 {
			reg = <0x0 0x4568>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x4568>;

			cpuapp_cpucell_ipc_shm_ctrl: sram0_ns_modem@0 {
				reg = <0x0 0x4e8>;
			};
			cpuapp_cpucell_ipc_shm_heap: sram0_ns_modem@4e8 {
				reg = <0x4e8 0x2080>;
			};
			cpucell_cpuapp_ipc_shm_heap: sram0_ns_modem@2568 {
				reg = <0x2568 0x2000>;
			};
		};
		sram0_ns_app: sram0_ns@4568 {
			reg = <0x4568 0x33a98>;
		};
	};
};
