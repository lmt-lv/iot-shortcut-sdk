if BOARD_LMT9151SOM_NRF9151 || BOARD_LMT9151SOM_NRF9151_NS

# For the secure version of the board the firmware is linked at the beginning
# of the flash, or into the code-partition defined in DT if it is intended to
# be loaded by MCUboot. If the secure firmware is to be combined with a non-
# secure image (TRUSTED_EXECUTION_SECURE=y), the secure FW image shall always
# be restricted to the size of its code partition.
# For the non-secure version of the board, the firmware
# must be linked into the code-partition (non-secure) defined in DT, regardless.
# Apply this configuration below by setting the Kconfig symbols used by
# the linker according to the information extracted from DT partitions.

# Workaround for not being able to have commas in macro arguments
DT_CHOSEN_Z_CODE_PARTITION := zephyr,code-partition

if BUILD_WITH_TFM
	# Explicitly define TFM Profile as Minimal, otherwise TFM is x2 in size (around 64kB).
	choice TFM_PROFILE_TYPE
		default TFM_PROFILE_TYPE_MINIMAL
	endchoice

	# When creating debug build TFM grows double in-size to around 64kB even with PROFILE_TYPE_MINIMAL.
	# This config makes it so that TFM debug symbols are not included in debug builds.
	choice TFM_CMAKE_BUILD_TYPE
		default TFM_CMAKE_BUILD_TYPE_MINSIZEREL
	endchoice

endif #BUILD_WITH_TFM

config BT_HCI_VS
	default y if BT

config BT_WAIT_NOP
	default BT && $(dt_nodelabel_enabled,nrf5340_reset)

config I2C
	default $(dt_compat_on_bus,$(DT_COMPAT_NXP_PCAL6408A),i2c)

endif # BOARD_LMT9151SOM_NRF9151 || BOARD_LMT9151SOM_NRF9151_NS
